# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/
*.tmp
*.ignis.tmp

# Package Files
*.jar
!.mvn/wrapper/maven-wrapper.jar
!libs/**/*.jar
# Bibliotecas privadas de projeto (ver doc/PROJECT_LIBS_GUIDE.md) - conteudo de
# projeto versionado, nao artefato de build acidental.
!projects/*/project/libs/*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs
hs_err_pid*
replay_pid*

# IDE
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Build directories
bin/
build/
out/
target/
dist/
build-tmp/

# Argfiles/manifests gerados por builds manuais (javac @argfile, lista de fontes)
args.txt
srcs.txt

# OS
.DS_Store
Thumbs.db
.gitkeep

# Runtime
*.pid
*.seed

# Local user projects (not part of the repository)
projects/MyGame/
projects/TensuraGame/

# AI assistant config
.claude/

# Estado volatil de coordenacao do MCP por projeto
projects/*/project/.ignis/
# Mural/claims/tarefas persistidos pelo MCP (McpCoordination) — transitorio, nao versionar
**/.ignis/coordination.json
