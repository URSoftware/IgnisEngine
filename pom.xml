<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ignis</groupId>
    <artifactId>ignis-engine</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Ignis Engine</name>
    <description>Java Game Engine Editor</description>

    <properties>
        <!-- Official supported Java version: 17 (LTS). 'release' pins both
             bytecode level and visible API, so builds on newer JDKs still
             produce 17-compatible classes. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- JavaFX 17 LTS — migracao da UI do editor (branch main). Ver doc/JAVAFX_MIGRATION_PLAN.md -->
        <javafx.version>17.0.12</javafx.version>
    </properties>

    <dependencies>
        <!-- JSON Library -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>

        <!-- Model Context Protocol SDK -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>2.0.0</version>
        </dependency>

        <!-- JavaFX (migracao da UI do editor — branch main). A ponte BufferedImage
             -> JavaFX usa FxImageBridge (PixelWriter), sem o modulo javafx-swing
             (removido na F4-C; SwingFXUtils eliminado). -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- RichTextFX for FxCodeEditor (Syntax Highlighting + Ghost Text) -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>0.11.1</version>
        </dependency>
        <!-- jdk.jsobject required by javafx.web on JDK 26+ -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>jdk-jsobject</artifactId>
            <version>26.0.1</version>
        </dependency>

        <!-- Testes de regressao (round-trip .ignis, consistencia EC, eventos).
             Rodar com: mvnw test  (tambem no CI a cada push) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            
            <groupId>com.fxutilities</groupId>
            <artifactId>FXEvents</artifactId>
            <version>1.0.0-SNAPSHOT</version>

        </dependency>

    </dependencies>

    <repositories>
    
        <repository>
        
            <id>project-local-repo</id>
            <url>file://${project.basedir}/libs/repository</url>
        
        </repository>
    
    </repositories>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test</testSourceDirectory>
        <resources>
            <!-- Bundle non-Java assets (editor icons) into the classpath so
                 getResource() works from target/classes and from packaged jars -->
            <resource>
                <directory>src</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Cobertura de testes (relatório em target/site/jacoco). Não falha o build:
                 a cobertura ainda é baixa; a meta é ganhar visibilidade e crescer. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Quality gate (item 1 do plano). Desde 07/07/2026 cobre TODO o src
                 (logging migrado para IgnisLogger em todos os pacotes); a única
                 exceção é o próprio sink (IgnisLogger). Roda em 'verify' (CI). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.3.1</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.17.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <sourceDirectories>
                        <sourceDirectory>src</sourceDirectory>
                        <sourceDirectory>test</sourceDirectory>
                    </sourceDirectories>
                    <includes>com/ignis/**/*.java</includes>
                    <excludes>com/ignis/core/IgnisLogger.java</excludes>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-core</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Editor JavaFX (principal). Rodar com:  mvnw javafx:run
                 O editor Swing classico (com.ignis.editor.Editor) foi removido do main
                 em 05/07/2026 e permanece apenas na branch Legado. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.ignis.editor.fx.IgnisEditorApp</mainClass>
                    <options>
                        <option>--upgrade-module-path</option>
                        <option>${settings.localRepository}/org/openjfx/jdk-jsobject/26.0.1/jdk-jsobject-26.0.1-win.jar</option>
                        <!-- Sem teto a JVM reserva ate 25% da RAM para o heap do editor;
                             somado ao Maven + javac in-process + jogo em Play, isso ja
                             esgotou a memoria nativa do sistema (hs_err 15/07/2026).
                             1.5GB e folgado para o editor 2D e mantem o SO respiravel. -->
                        <option>-Xmx1536m</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
