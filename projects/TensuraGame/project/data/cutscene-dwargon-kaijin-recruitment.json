    },
    {
      "id": "guard_questions_the_request",
      "cameraCue": "guard_rimuru_medium",
      "lines": [
        {
          "id": "dkr_001",
          "speaker": "guard",
          "portrait": null,
          "text": "Dwargon protege seus oficios. Diga com clareza: veio comprar ferramentas ou levar segredos da cidade?"
        },
        {
          "id": "dkr_002",
          "speaker": "rimuru",
          "portrait": "calm",
          "text": "Nenhum dos dois. Minha aldeia precisa de pessoas dispostas a construir algo novo conosco."
        }
      ]
    },
    {
      "id": "kaijin_volunteers",
      "cameraCue": "kaijin_forge_foreground",
      "eventsOnEnter": ["kaijin_steps_forward"],
      "lines": [
        {
          "id": "dkr_003",
          "speaker": "kaijin",
          "portrait": "kaijin_portrait_v1",
          "text": "Uma oficina vazia nao ensina ninguem. Se houver trabalho honesto e escolha, eu ouvirei a proposta."
        },
        {
          "id": "dkr_004",
          "speaker": "rimuru",
          "portrait": "friendly",
          "text": "Entao venha conhecer Tempest. Voce decide o que ensinar, e nos dividimos o que conseguirmos criar."
        },
        {
          "id": "dkr_005",
          "speaker": "guard",
          "portrait": null,
          "text": "Voluntarios nao quebram o protocolo. Registre a partida e mantenha o portao aberto para o retorno."
        }
      ],
      "eventsAfterLastLine": ["dwargon_artisan_crew_reveal"]
    },
    {
      "id": "agreement",
      "cameraCue": "rimuru_kaijin_artisans_group",
      "oneShotClips": ["vfx_name_exchange_magicule_wave"],
      "eventsOnEnter": ["dwargon_recruitment_vfx"],
      "lines": [
        {
          "id": "dkr_006",
          "speaker": "kaijin",
          "portrait": "kaijin_portrait_v1",
          "text": "Levarei ferramentas, amostras e minha equipe. O resto construiremos quando chegarmos."
        }
      ],
      "eventsAfterLastLine": ["dwargon_recruitment_complete"]
    }
  ]
