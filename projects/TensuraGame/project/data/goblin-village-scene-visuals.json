      "TownConfirmButton": "signal:TENSURA_COUNCIL_CONFIRM",
      "TownCouncilCloseButton": "signal:TENSURA_COUNCIL_CLOSE"
    },
    "modalPolicy": {
      "blocksExplorationInput": true,
      "inputOwnerWhileVisible": "TownCouncilCanvas",
      "activationKeys": ["TAB", "SHIFT+TAB", "ENTER", "SPACE"],
      "restoreExplorationInputOn": ["report_close", "council_close", "scene_transition", "runtime_error"],
      "restoreExactlyOnce": true
    },
    "focusPolicy": {
      "reportFirstPage": "TownReportNextButton",
      "reportIntermediatePage": "TownReportNextButton",
      "reportLastPage": "TownOpenCouncilButton",
      "councilOpen": "TownShelterTabButton",
      "reportOrder": [
        "TownReportNextButton",
        "TownReportCloseButton"
      ],
      "reportLastPageOrder": [
        "TownOpenCouncilButton",
        "TownReportCloseButton"
      ],
      "councilOrder": [
        "TownShelterTabButton",
        "TownWorkshopTabButton",
        "TownPalisadeTabButton",
        "TownConfirmButton",
        "TownCouncilCloseButton"
      ]
    },
    "displayRules": {
      "reportBeforeLastPage": {
        "show": ["TownReportNextButton", "TownReportCloseButton"],
        "hide": ["TownOpenCouncilButton"]
      },
      "reportLastPage": {
        "show": ["TownOpenCouncilButton", "TownReportCloseButton"],
        "hide": ["TownReportNextButton"]
      },
      "council": {
        "show": [
          "TownShelterTabButton",
          "TownWorkshopTabButton",
          "TownPalisadeTabButton",
          "TownConfirmButton",
          "TownCouncilCloseButton"
        ],
        "hide": [
          "TownReportNextButton",
          "TownOpenCouncilButton",
          "TownReportCloseButton"
        ]
      }
    },
    "runtimeAcceptance": {
      "reportOpenPayloadType": "ReturnReport",
      "reportOpenCommand": "TownCommand.ApplyReturnReport",
      "applyReportBeforeRendering": true,
      "reportApplication": "exactly_once_by_report_id",
      "maximumConcurrentProjectsInProgress": 1,
      "confirmDisabledWithoutValidSelection": true,
      "confirmDisabledWhileAnotherProjectIsInProgress": true
    }
  },
  "invariants": [
    "GoblinVillageScene owns village props; MainScene and JuraForestScene never render them.",
    "Rimuru, Ranga, GoblinElder and GoblinScout are unique actors and are never cloned by a cutscene.",
    "State changes replace the sprite of one prop instead of creating a second prop.",
    "All coordinates are local to GoblinVillageScene and the player remains inside the safe margin.",
    "No chroma-key, solid gray backdrop or opaque full-screen overlay is allowed in gameplay.",
    "Cutscene completion and skip converge on the same idempotent state before input returns.",
    "Legacy anchors are preserved until the save migration maps them to the expanded layout."
  ]
}
